# Copy to .env (git ignores it) or set these on the server. Never commit real values.

# MongoDB connection string. Leave unset in development to use a local database in .data/mongo.
MONGODB_URI=
MONGODB_DB=pyena

# Port for `npm start` (production).
PORT=8787

# Send the session cookie over HTTPS only. Set to true on the deployed server.
COOKIE_SECURE=false
SESSION_DAYS=14

# Allow anyone to create an account. Set to false to keep sign-up closed.
ALLOW_SIGNUP=true

# AI interpretation. Set one key; leave both unset to offer only the built-in interpretation.
# When both are set, Anthropic's Claude is used.
ANTHROPIC_API_KEY=
# Defaults to claude-opus-5-5.
ANTHROPIC_MODEL=

# OpenAI, used when ANTHROPIC_API_KEY is unset.
OPENAI_API_KEY=
# Defaults to gpt-5. Set it to any chat model your OpenAI account can use.
OPENAI_MODEL=
